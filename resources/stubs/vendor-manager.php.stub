<?php
/**
 * SharedSync Vendor Manager - Self-contained PHP file.
 *
 * Uploaded to public/ on each vendor deployment and removed once the
 * operation finishes. Runs entirely outside Laravel so it works even
 * when the vendor directory is missing or incomplete.
 *
 * Supported actions (passed via ?action=...):
 *  - extract  : Extracts a previously uploaded zip into the project root.
 *  - composer : Runs `composer install --no-dev --optimize-autoloader`.
 *  - ping     : Returns ok (used to confirm the file is reachable).
 *
 * Authentication: a one-time token is embedded in this file at upload
 * time (placeholder __SHAREDSYNC_TOKEN__) and must be provided as the
 * `token` query parameter using a hash_equals comparison.
 */

header('Content-Type: application/json');

$EXPECTED_TOKEN = '__SHAREDSYNC_TOKEN__';

$provided = $_GET['token'] ?? $_POST['token'] ?? '';
if (!is_string($provided) || $EXPECTED_TOKEN === '__SHAREDSYNC_TOKEN__' || !hash_equals($EXPECTED_TOKEN, $provided)) {
    http_response_code(401);
    echo json_encode(['status' => 'error', 'message' => 'Invalid or missing token.']);
    exit;
}

// Project root is one level up from public/ in a standard Laravel layout.
$projectRoot = realpath(__DIR__ . '/..');
if ($projectRoot === false) {
    http_response_code(500);
    echo json_encode(['status' => 'error', 'message' => 'Unable to resolve project root.']);
    exit;
}

$action = $_GET['action'] ?? 'ping';

try {
    switch ($action) {
        case 'ping':
            echo json_encode(['status' => 'success', 'message' => 'pong']);
            break;

        case 'extract':
            $zipPath = $_GET['zip'] ?? 'sharedsync-vendor.zip';
            // Only allow a simple filename in public/, no path traversal.
            $zipPath = basename($zipPath);
            $fullZipPath = __DIR__ . '/' . $zipPath;

            if (!file_exists($fullZipPath)) {
                http_response_code(404);
                echo json_encode(['status' => 'error', 'message' => "Zip file not found: {$zipPath}"]);
                exit;
            }

            if (!class_exists('ZipArchive')) {
                http_response_code(500);
                echo json_encode(['status' => 'error', 'message' => 'ZipArchive extension not available on the server.']);
                exit;
            }

            $zip = new ZipArchive();
            $opened = $zip->open($fullZipPath);
            if ($opened !== true) {
                http_response_code(500);
                echo json_encode(['status' => 'error', 'message' => "Failed to open zip (code {$opened})."]);
                exit;
            }

            // Optional: clean target vendor dir first to avoid stale files.
            $vendorDir = $projectRoot . '/vendor';
            if (is_dir($vendorDir)) {
                sharedsync_rrmdir($vendorDir);
            }

            if (!$zip->extractTo($projectRoot)) {
                $zip->close();
                http_response_code(500);
                echo json_encode(['status' => 'error', 'message' => 'Failed to extract zip.']);
                exit;
            }
            $zip->close();

            @unlink($fullZipPath);

            echo json_encode(['status' => 'success', 'message' => 'Vendor extracted.']);
            break;

        case 'composer':
            $composerBin = $_GET['composer'] ?? 'composer';
            // Basic sanitization: only allow simple binary names/paths.
            if (!preg_match('#^[A-Za-z0-9_./-]+$#', $composerBin)) {
                $composerBin = 'composer';
            }

            $cmd = sprintf(
                '%s install --no-dev --optimize-autoloader --no-interaction --working-dir=%s 2>&1',
                escapeshellcmd($composerBin),
                escapeshellarg($projectRoot)
            );

            $output = [];
            $exitCode = 0;
            exec($cmd, $output, $exitCode);

            echo json_encode([
                'status' => $exitCode === 0 ? 'success' : 'error',
                'exit_code' => $exitCode,
                'output' => implode("\n", $output),
            ]);
            break;

        default:
            http_response_code(400);
            echo json_encode(['status' => 'error', 'message' => "Unknown action: {$action}"]);
    }
} catch (\Throwable $e) {
    http_response_code(500);
    echo json_encode(['status' => 'error', 'message' => $e->getMessage()]);
}

function sharedsync_rrmdir(string $dir): void
{
    if (!is_dir($dir)) {
        return;
    }
    $items = scandir($dir);
    foreach ($items as $item) {
        if ($item === '.' || $item === '..') {
            continue;
        }
        $path = $dir . DIRECTORY_SEPARATOR . $item;
        if (is_link($path)) {
            @unlink($path);
        } elseif (is_dir($path)) {
            sharedsync_rrmdir($path);
        } else {
            @unlink($path);
        }
    }
    @rmdir($dir);
}
