<?php
/**
 * SharedSync Vendor Manager - Self-contained PHP file.
 *
 * Uploaded to public/ on each vendor deployment and removed once the
 * operation finishes. Runs entirely outside Laravel so it works even
 * when the vendor directory is missing or incomplete.
 *
 * Supported actions (passed via ?action=...):
 *  - extract  : Zips old vendor, deletes it, and extracts the new zip.
 *  - ping     : Returns ok (used to confirm the file is reachable).
 *
 * Authentication: a one-time token is embedded in this file at upload
 * time (placeholder __SHAREDSYNC_TOKEN__) and must be provided as the
 * `token` query parameter using a hash_equals comparison.
 */

header('Content-Type: application/json');

$EXPECTED_TOKEN = '__SHAREDSYNC_TOKEN__';

$provided = $_GET['token'] ?? $_POST['token'] ?? '';

if (!is_string($provided) || $provided === '') {
    http_response_code(401);
    echo json_encode([
        'status' => 'error',
        'reason' => 'token_missing',
        'message' => 'No token was provided in the request.',
    ]);
    exit;
}

if (!hash_equals($EXPECTED_TOKEN, $provided)) {
    http_response_code(401);
    echo json_encode([
        'status' => 'error',
        'reason' => 'token_mismatch',
        'message' => 'Invalid token.',
    ]);
    exit;
}

// Project root is one level up from public/ in a standard Laravel layout.
$projectRoot = realpath(__DIR__ . '/..');
if ($projectRoot === false) {
    http_response_code(500);
    echo json_encode(['status' => 'error', 'message' => 'Unable to resolve project root.']);
    exit;
}

$action = $_GET['action'] ?? 'ping';

try {
    switch ($action) {
        case 'ping':
            echo json_encode(['status' => 'success', 'message' => 'pong']);
            break;

        case 'extract':
            $zipFile = $_GET['zip'] ?? '';
            // Only allow a simple filename in public/, no path traversal.
            $zipFile = basename($zipFile);
            $fullZipPath = __DIR__ . '/' . $zipFile;

            if (empty($zipFile) || !file_exists($fullZipPath)) {
                http_response_code(404);
                echo json_encode(['status' => 'error', 'message' => "Zip file not found: {$zipFile}"]);
                exit;
            }

            if (!class_exists('ZipArchive')) {
                http_response_code(500);
                echo json_encode(['status' => 'error', 'message' => 'ZipArchive extension not available on the server.']);
                exit;
            }

            $vendorDir = $projectRoot . DIRECTORY_SEPARATOR . 'vendor';

            // 1. Zip the current vendor if it exists
            if (is_dir($vendorDir)) {
                $oldZipName = 'vendor-old-' . $EXPECTED_TOKEN . '.zip';
                $oldZipPath = __DIR__ . DIRECTORY_SEPARATOR . $oldZipName;
                
                $zipOld = new ZipArchive();
                if ($zipOld->open($oldZipPath, ZipArchive::CREATE | ZipArchive::OVERWRITE) === true) {
                    $files = new RecursiveIteratorIterator(
                        new RecursiveDirectoryIterator($vendorDir, RecursiveDirectoryIterator::SKIP_DOTS),
                        RecursiveIteratorIterator::SELF_FIRST
                    );

                    foreach ($files as $name => $file) {
                        $filePath = $file->getRealPath();
                        $relativePath = 'vendor' . DIRECTORY_SEPARATOR . substr($filePath, strlen($vendorDir) + 1);

                        if ($file->isDir()) {
                            $zipOld->addEmptyDir($relativePath);
                        } else {
                            $zipOld->addFile($filePath, $relativePath);
                        }
                    }
                    $zipOld->close();
                }
            }

            // 2. Delete the current vendor dir
            if (is_dir($vendorDir)) {
                sharedsync_rrmdir($vendorDir);
            }

            // 3. Extract the new vendor zip
            $zip = new ZipArchive();
            $opened = $zip->open($fullZipPath);
            if ($opened !== true) {
                http_response_code(500);
                echo json_encode(['status' => 'error', 'message' => "Failed to open new zip (code {$opened})."]);
                exit;
            }

            if (!$zip->extractTo($projectRoot)) {
                $zip->close();
                http_response_code(500);
                echo json_encode(['status' => 'error', 'message' => 'Failed to extract new zip.']);
                exit;
            }
            $zip->close();

            echo json_encode(['status' => 'success', 'message' => 'Vendor updated successfully.']);
            break;

        default:
            http_response_code(400);
            echo json_encode(['status' => 'error', 'message' => "Unknown action: {$action}"]);
    }
} catch (\Throwable $e) {
    http_response_code(500);
    echo json_encode(['status' => 'error', 'message' => $e->getMessage()]);
}

function sharedsync_rrmdir(string $dir): void
{
    if (!is_dir($dir)) {
        return;
    }
    $items = scandir($dir);
    foreach ($items as $item) {
        if ($item === '.' || $item === '..') {
            continue;
        }
        $path = $dir . DIRECTORY_SEPARATOR . $item;
        if (is_link($path)) {
            @unlink($path);
        } elseif (is_dir($path)) {
            sharedsync_rrmdir($path);
        } else {
            @unlink($path);
        }
    }
    @rmdir($dir);
}
